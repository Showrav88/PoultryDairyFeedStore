# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# VPS deploy runtime — written by deploy/*.sh on the server (never commit)
.deploy-sha
.deploy-status
.deploy.lock

# deploy logs (written on VPS under app dir)
/logs/
deploy.log
*.deploy.log

# credentials / keys (never commit)
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
github_actions
github_actions.pub

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
