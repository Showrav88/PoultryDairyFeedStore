#!/usr/bin/env bash
# Installed to /usr/local/sbin/sync-newproject-origin
# Self-contained — does not depend on repo deploy scripts (works when checkout is dirty).
set -Eeuo pipefail

APP_DIR="${1:-/var/www/NEWPROJECT}"
BRANCH="${2:-main}"
APP_USER="newproject"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run as root"
  exit 1
fi

chown -R "${APP_USER}:${APP_USER}" "$APP_DIR" 2>/dev/null || true

git -C "$APP_DIR" config --global --add safe.directory "$APP_DIR" 2>/dev/null || true

echo "Fetching origin/${BRANCH} ..."
git -C "$APP_DIR" fetch origin "$BRANCH"

echo "Resetting working tree to origin/${BRANCH} ..."
git -C "$APP_DIR" checkout -f "$BRANCH"
git -C "$APP_DIR" reset --hard "origin/${BRANCH}"

git -C "$APP_DIR" clean -fd \
  -e .env \
  -e .env.local \
  -e node_modules \
  -e .next \
  -e logs \
  -e .deploy-sha \
  -e .deploy-status \
  -e .deploy.lock \
  -e src/generated

chown -R "${APP_USER}:${APP_USER}" "$APP_DIR"

echo "Checkout at $(git -C "$APP_DIR" rev-parse --short HEAD)"
